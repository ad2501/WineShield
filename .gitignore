# WineShield — Extended .gitignore
# =================================
# Patterns below are project-specific.  The file ensures that
# build artefacts, credentials, OS junk, and temporary files
# never accidentally end up in the repository.

# ---- Build artefacts ----
*.o
*.pyc
*.pyo
__pycache__/
*.deb
*.so
*.egg-info/
dist/
build/
*.exe

# ---- IDE / Editor ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- Environment / Secrets ----
.env
*.env.local
credentials.json
*.pem
*.key

# ---- Logs ----
*.log
wineshield.log
/var/log/wineshield/

# ---- User data (⚠️ never commit sandbox content) ----
Notepad++/
~/.wine/
~/.wineshield/
*.wineprefix/

# ---- Python ----
venv/
.venv/
*.egg
MANIFEST

# ---- Testing ----
.coverage
htmlcov/
.pytest_cache/

# ---- System files ----
*.swp
core
